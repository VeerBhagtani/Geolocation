# Copy this file to .env and fill in your key. Never commit .env.
GOOGLE_GEOCODING_API_KEY=your-google-geocoding-api-key-here

# Optional settings
# Max Google requests per second (Google's default limit is far higher; 10 is safe)
REQUESTS_PER_SECOND=10
# Region bias for ambiguous addresses (ccTLD code). "in" = India
GEOCODING_REGION=in
# Local port
PORT=8765

# Optional cost estimate. Check the CURRENT price on
# https://developers.google.com/maps/billing-and-pricing/pricing and enter it here.
# Leave blank to show only the request count.
GEOCODING_PRICE_PER_1000=
GEOCODING_PRICE_CURRENCY=USD
GEOCODING_FREE_REQUESTS_PER_MONTH=
